{
  "manifest_version": 3,
  "name": "Flight Dispatch — VATSIM Companion",
  "version": "1.0.0",
  "description": "Files the flight plan requested by your local Flight Dispatch app using your signed-in VATSIM browser session.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://my.vatsim.net/*",
    "https://auth.vatsim.net/*",
    "https://connect.vatsim.net/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Flight Dispatch",
    "default_popup": "popup.html"
  }
}
